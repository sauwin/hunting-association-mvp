# All values below are development placeholders - use your own secrets elsewhere.

# --- Django ---
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (read by both the `db` and the `web` service) ---
DB_NAME=hunting_db
DB_USER=hunting_user
DB_PASSWORD=secret_password
# Compose always overrides DB_HOST/DB_PORT for `web` with db:5432.
DB_HOST=db
DB_PORT=5432

# --- Host ports published by docker compose (change if already in use) ---
WEB_PORT=8000
DB_HOST_PORT=5432

# --- Demo data ---
# True  = load synthetic demo data on every container start (idempotent).
# False = migrations only.
SEED_DEMO_DATA=True

# --- Email ---
# The console backend prints emails to the container log; nothing is ever sent.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@hunting-association-mvp.local
