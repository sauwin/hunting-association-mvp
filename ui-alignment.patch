+{% comment %}
+  One Django form field with label, help text and errors, in Student B's form style.
+  Usage: {% include "common/_form_field.html" with field=form.email %}
+  The input itself is styled by common.forms.TailwindFormMixin (classes set on the widget).
+{% endcomment %}
+{% if field.is_hidden %}
+    {{ field }}
+{% else %}
+<div>
+    {% if field.widget_type == "checkbox" %}
+        <div class="flex items-start gap-3">
+            <span class="mt-0.5">{{ field }}</span>
+            <label for="{{ field.id_for_label }}" class="text-sm font-semibold text-stone-700">{{ field.label }}</label>
+        </div>
+        {% if field.help_text %}
+            <p class="mt-1.5 ml-7 text-xs leading-relaxed text-stone-500">{{ field.help_text }}</p>
+        {% endif %}
+    {% else %}
+        <label for="{{ field.id_for_label }}" class="block text-sm font-semibold text-stone-700 mb-1.5">
+            {{ field.label }}{% if field.field.required %} <span class="text-red-600">*</span>{% endif %}
+        </label>
+        {{ field }}
+        {% if field.help_text %}
+            <p class="mt-1 text-xs text-stone-500">{{ field.help_text }}</p>
+        {% endif %}
+    {% endif %}
+    {% for error in field.errors %}
+        <p class="mt-1 text-xs text-red-600">{{ error }}</p>
+    {% endfor %}
+</div>
+{% endif %}
